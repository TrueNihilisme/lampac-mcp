# Generate a private random value of at least 32 characters before starting.
MCP_TOKEN=CHANGE_ME

# Exact browser origins allowed to call /mcp. Empty Origin is allowed for native MCP clients.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bind to loopback by default. Set explicitly when a reverse proxy needs to reach the service.
HOST=127.0.0.1
PORT=8787

# The base URL of the Lampac instance to inspect (read-only /lite/events requests).
LAMPAC_URL=
LAMPAC_ROOT_PASSWORD=

# Writes remain disabled until explicitly enabled by the operator.
MCP_ENABLE_WRITES=false

# Optional path for persistent collection data.
# COLLECTIONS_FILE=./data/collections.json
